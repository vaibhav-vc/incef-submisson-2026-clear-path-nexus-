# Copy to railguard.env and fill in. Generate each secret with: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit railguard.env. Every value here is a placeholder.
RAILGUARD_VIEWER_TOKEN=replace-with-64-hex-characters
RAILGUARD_CONTROLLER_TOKEN=replace-with-64-hex-characters
RAILGUARD_FEED_TOKEN=replace-with-64-hex-characters
RAILGUARD_AUDIT_KEY=replace-with-64-hex-characters
RAILGUARD_CHECKPOINT_KEY=replace-with-64-hex-characters
RAILGUARD_ALLOWED_HOSTS=railguard.example.internal
# Authorised live feeds (per source, per key): SOURCE:key_id:hexsecret,...
RAILGUARD_FEED_KEYS=
# UPS through Network UPS Tools on the host (upsd listening on 3493): <ups name>@<host>
RAILGUARD_UPS=ups@host.docker.internal
# Twin clock follows Indian Standard Time in live operation
RAILGUARD_LIVE_CLOCK=1
RAILGUARD_TIMETABLE=current
RAILGUARD_AUDIT_DIR=/audit
