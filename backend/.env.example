# CLEARPATH NEXUS CORE SERVICE ENGINE CONFIGURATION

ENVIRONMENT=development
DEBUG=False
SECRET_KEY=replace_with_a_random_32_character_secret
EVIDENCE_SIGNING_KEY=replace_with_a_different_random_32_character_secret
EVIDENCE_SIGNING_KEY_ID=evidence-hmac-v1
EVIDENCE_SIGNING_ALGORITHM=HMAC-SHA256
# JSON map of retired key IDs to retained verification-only secrets.
EVIDENCE_VERIFICATION_KEYS={}
PROJECT_NAME="ClearPath Nexus Engine"

# Supabase is the single identity provider for web and Android.
SUPABASE_URL=https://your-project.supabase.co
# Only needed for legacy HS256 Supabase projects; modern projects use JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_DISABLED=false

POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=replace_with_a_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clearpath_nexus_db
# Managed providers commonly issue postgres:// or postgresql:// URLs; the app
# normalizes either form to asyncpg. Use a direct or session-pooler endpoint;
# SQLAlchemy asyncpg prepares statements and therefore rejects Supabase's
# transaction-pooler endpoint.
DATABASE_URL=postgresql+asyncpg://nexus_admin:replace_with_a_database_password@localhost:5432/clearpath_nexus_db
DATABASE_POOL_MODE=queue
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_PREPARED_STATEMENT_CACHE_SIZE=100

# Preferred setting. redis:// supports username/password; rediss:// also
# enables TLS for managed Redis. Host/port/db remain a local fallback.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Timetable providers are deliberately blank by default. Configure only a
# legitimate HTTPS agency/feed URL; no timetable is bundled or inferred.
GTFS_STATIC_FEED_URL=
GTFS_STATIC_SOURCE_NAME=Configured GTFS static feed
GTFS_REALTIME_FEED_URL=
GTFS_REALTIME_SOURCE_NAME=Configured GTFS-Realtime feed
GTFS_SOURCE_LICENSE=
INDIA_RAILWAYS_TIMETABLE_API_URL=
INDIA_RAILWAYS_TIMETABLE_API_KEY=
INDIA_RAILWAYS_SOURCE_NAME=India Open Government Data timetable
INDIA_RAILWAYS_SOURCE_LICENSE=
TIMETABLE_MAX_FEED_BYTES=104857600
NOAA_SPACE_WEATHER_FEED_URL=https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json
# Required for production route-to-port alignment. Obtain from an authorized provider.
MARITIME_BERTH_DATA_FEED=
MARITIME_FEED_API_KEY=
AUTH_COOKIE_NAME=clearpath_session
AUTH_REFRESH_COOKIE_NAME=clearpath_refresh
CSRF_COOKIE_NAME=clearpath_csrf
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
DEMO_DATA_ENABLED=false
# Production/staging fail closed unless every operational input is real and
# source-attributed. Keep false only for the explicitly labelled local judge
# replay (which is not live data).
REAL_DATA_ONLY=true
APPROVAL_ALLOWED_ROLES=["operator","approver","admin"]
# Exact admin-approved issuer identities accepted by the engineering importer.
ENGINEERING_CERTIFICATION_ALLOWED_ISSUERS=[]
RAILWAY_OPERATIONS_FEED=
RAILWAY_FEED_API_KEY=
DUST_AIR_QUALITY_FEED_URL=
DUST_AIR_QUALITY_PROVIDER_NAME=open_meteo_air_quality
# Optional: free RailRadar sandbox key for a live passenger-train demo layer.
# Not a freight feed, not required — the app runs fine with this unset.
RAILRADAR_API_KEY=
RAILRADAR_CACHE_TTL_SECONDS=7200
RAILRADAR_MONTHLY_BUDGET=900
RAILRADAR_CORRIDOR_STATIONS=
AISSTREAM_API_KEY=
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
AIS_COLLECTOR_ENABLED=false
LIVE_CONGESTION_ENABLED=true
LIVE_CONGESTION_WEIGHT=0.6

# Master network kill switch for a deterministic judge/offline deployment.
# When false, every HTTP/WebSocket operational provider returns an explicit
# UNAVAILABLE result and makes no provider request. Local DB/Redis still run.
LIVE_DATA_ENABLED=true
ENABLE_LIVE_WEATHER=true
ENABLE_LIVE_RAIL=true
ENABLE_LIVE_AIS=false
ENABLE_LIVE_GPS=true
ENABLE_EVENT_ENGINE=true
ENABLE_ML_INFERENCE=true
IXIGO_SYNC_ENABLED=false

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

WEIGHT_WEATHER_RISK=0.40
WEIGHT_PORT_ALIGNMENT=0.30
WEIGHT_CORRIDOR_CONGESTION=0.15
WEIGHT_HISTORICAL_DELAY=0.15
